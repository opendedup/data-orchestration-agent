# =============================================================================
# Data Orchestration Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# =============================================================================

# =============================================================================
# Google Cloud Platform Configuration (REQUIRED)
# =============================================================================

# Google Cloud Project ID
# REQUIRED: Your GCP project ID where BigQuery and other services are located
GCP_PROJECT_ID=your-project-id-here

# Google Cloud Service Account Credentials
# REQUIRED: Path to your service account JSON key file
# Download from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Google AI API Key
# REQUIRED: API key for Gemini model access
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-ai-api-key-here

# =============================================================================
# Agent Configuration
# =============================================================================

# Gemini Model to use
# Default: gemini-2.5-flash
# Options: gemini-2.5-flash, gemini-2.0-flash-001, gemini-1.5-pro, etc.
AGENT_MODEL=gemini-2.5-flash

# AG-UI Server Host
# Default: 0.0.0.0 (listens on all interfaces)
# For localhost only: 127.0.0.1
AGENT_HOST=0.0.0.0

# AG-UI Server Port
# Default: 8085
AGENT_PORT=8085

# Enable CORS for Development
# Default: true
# Set to 'true' to allow cross-origin requests from frontend applications
# Set to 'false' in production for better security
ENABLE_CORS=true

# Logging Level
# Default: INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# MCP Service URLs
# =============================================================================

# Data Discovery Agent MCP Service
# Default: http://localhost:8080
DISCOVERY_AGENT_URL=http://localhost:8080

# Query Generation Agent MCP Service
# Default: http://localhost:8081
QUERY_GEN_AGENT_URL=http://localhost:8081

# GraphQL Agent MCP Service
# Default: http://localhost:8083
GRAPHQL_AGENT_URL=http://localhost:8083

# Apollo MCP Server
# Default: http://localhost:8084
APOLLO_MCP_URL=http://localhost:8084

# =============================================================================
# Timeouts and Limits
# =============================================================================

# HTTP Request Timeout (seconds)
# Default: 300.0
# Timeout for HTTP requests to MCP services
HTTP_TIMEOUT=300.0

# Maximum Planning Conversation Turns
# Default: 10
# Maximum number of Q&A turns during PRP creation
MAX_PLANNING_TURNS=10

# Maximum Queries Per Target Table
# Default: 3
# Maximum number of SQL queries to generate per target table
MAX_QUERIES_PER_TARGET=3

# Maximum Query Refinement Iterations
# Default: 10
# Maximum iterations for refining generated SQL queries
MAX_QUERY_ITERATIONS=10

# =============================================================================
# BigQuery Configuration
# =============================================================================

# BigQuery Maximum Retry Attempts
# Default: 3
# Number of retry attempts for failed BigQuery operations
BIGQUERY_MAX_RETRIES=3

# BigQuery Query Timeout (seconds)
# Default: 300
# Timeout for BigQuery query execution
BIGQUERY_TIMEOUT=300

# =============================================================================
# Optional: Docker Compose Configuration
# =============================================================================
# These are used if deploying with Docker Compose

# Project name for docker-compose (optional)
# COMPOSE_PROJECT_NAME=data-orchestration-agent

# Docker network name (optional)
# DOCKER_NETWORK=data-agent-network
