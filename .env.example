# Data Orchestration Agent - Environment Configuration

# ============================================================================
# Google AI API Configuration (Required for ADK mode)
# ============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ============================================================================
# Agent Model Configuration
# ============================================================================
# Google AI model to use for the agent
AGENT_MODEL=gemini-flash-latest

# ============================================================================
# GCP Configuration (Required)
# ============================================================================
# Google Cloud Project ID
GCP_PROJECT_ID=your-project-id

# ============================================================================
# MCP Service URLs
# ============================================================================
# Data Discovery Agent MCP service URL
DISCOVERY_AGENT_URL=http://localhost:8080

# Query Generation Agent MCP service URL
QUERY_GEN_AGENT_URL=http://localhost:8081

# Data Planning Agent MCP service URL
PLANNING_AGENT_URL=http://localhost:8082

# GraphQL Agent MCP service URL
GRAPHQL_AGENT_URL=http://localhost:8083

# Apollo MCP Server URL
APOLLO_MCP_URL=http://localhost:8084

# ============================================================================
# Agent Web Server Configuration
# ============================================================================
# Host address for the agent web server
AGENT_HOST=0.0.0.0

# Port number for the agent web server
AGENT_PORT=8085

# ============================================================================
# Timeouts and Limits
# ============================================================================
# HTTP request timeout in seconds
HTTP_TIMEOUT=300.0

# Maximum number of planning conversation turns
MAX_PLANNING_TURNS=10

# Maximum number of queries to generate per target table
MAX_QUERIES_PER_TARGET=3

# Maximum iterations for query generation refinement
MAX_QUERY_ITERATIONS=10
